# Copy this file to .env (which is gitignored) and fill in the values.

# SEC EDGAR requires automated clients to declare who they are, as "Name email".
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Your Name you@example.com

# Claude API key, used from Week 2 onward.
ANTHROPIC_API_KEY=
